{
  "name": "rewrite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REWRITE - a story-driven roguelike where knowledge is the only thing that survives death",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "npm run build && node --test \"dist/core/test/*.test.js\"",
    "sim": "npm run build && node dist/core/test/sim/three-runs.js",
    "start": "npm run build && node dist/server/src/index.js",
    "dev": "npm run build && node dist/server/src/index.js",
    "build:assets": "npm run build && node tools/build-assets.mjs",
    "cf:dev": "npm run build:assets && wrangler dev",
    "cf:deploy": "npm run build:assets && wrangler deploy",
    "cf:secret": "wrangler secret put ANTHROPIC_API_KEY"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.2",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}